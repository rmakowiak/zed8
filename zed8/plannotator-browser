#!/usr/bin/env python3
"""Plannotator browser hook for the Zed fork.

Plannotator runs this with the session URL when PLANNOTATOR_BROWSER is its
path. If a running fork Zed has the session's worktree open, Zed takes the
session and no browser opens. Otherwise the browser in ZED_FALLBACK_BROWSER
opens. For a spec review (a markdown file), the worktree is the folder of the
file or the folder that the Claude process behind the session runs in, as in
`spec_belongs_to` in crates/plannotator_review/src/session.rs. A plan from
Claude Code plan mode has no file, so only the Claude process counts.
"""
import glob
import json
import os
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
FALLBACK = os.environ.get("ZED_FALLBACK_BROWSER", "Google Chrome")


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except PermissionError:
        return True
    except (OSError, ValueError):
        return False


def read(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def session_for(url):
    # The session file can appear a moment after the browser call.
    for _ in range(20):
        for path in glob.glob(f"{HOME}/.plannotator/sessions/*.json"):
            session = read(path)
            if session and session.get("url") == url:
                return session
        time.sleep(0.1)
    return None


def zed_roots():
    roots = []
    for path in glob.glob(f"{HOME}/.plannotator/zed-windows/*.json"):
        window = read(path)
        if window and alive(window.get("pid", 0)):
            roots.extend(window.get("roots", []))
        elif window:
            os.remove(path)
    return [os.path.realpath(root) for root in roots]


def ancestor_cwds(pid):
    try:
        out = subprocess.run(["ps", "-axo", "pid=,ppid="], capture_output=True, text=True).stdout
    except OSError:
        return []
    parents = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2:
            parents[int(parts[0])] = int(parts[1])
    cwds = []
    seen = set()
    current = int(pid)
    while current in parents and parents[current] > 1 and parents[current] not in seen:
        current = parents[current]
        seen.add(current)
        try:
            lsof = subprocess.run(
                ["lsof", "-a", "-p", str(current), "-d", "cwd", "-Fn"],
                capture_output=True,
                text=True,
            ).stdout
        except OSError:
            continue
        for row in lsof.splitlines():
            if row.startswith("n") and row != "n/":
                cwds.append(os.path.realpath(row[1:]))
    return cwds


def inside(path, roots):
    return any(path == root or path.startswith(root + os.sep) for root in roots)


def zed_takes(session):
    if not session:
        return False
    # The Review panel announces its worktrees every 2 seconds. Ask again for
    # a moment, so a window that is just opening, or that lost a worktree for
    # a moment, still takes the session.
    for _ in range(6):
        if zed_takes_now(session, zed_roots()):
            return True
        time.sleep(0.5)
    return False


def zed_takes_now(session, roots):
    if not roots:
        return False
    target = os.path.realpath(session.get("target") or "")
    if session.get("mode") == "annotate":
        if not target.endswith((".md", ".mdx", ".markdown")):
            return False
        if inside(target, roots):
            return True
        return any(inside(cwd, roots) for cwd in ancestor_cwds(session.get("pid", 0)))
    if session.get("mode") == "plan":
        return any(inside(cwd, roots) for cwd in ancestor_cwds(session.get("pid", 0)))
    if session.get("mode") == "review":
        if inside(target, roots):
            return True
        return any(inside(cwd, roots) for cwd in ancestor_cwds(session.get("pid", 0)))
    return False


def main():
    url = sys.argv[-1]
    if zed_takes(session_for(url)):
        return
    subprocess.run(["open", "-a", FALLBACK, url], check=False)


main()
